rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All user data is scoped under /users/{userId}
    // Only the authenticated user can read or write their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Review links: publicly readable by anyone who has the token (the
    // document ID). Never grants access to the owner's live
    // /users/{uid}/nodes data — shared content lives only in the
    // subcollections below, copied there explicitly by the owner.
    match /shareLinks/{token} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // One doc per shared chapter/scene. The owner creates/syncs these;
      // reviewers write back their suggested edits (tracked-change marks
      // baked into `content`, never a silent overwrite of clean prose).
      // No public delete — revoking the link is enough since nothing
      // outside this subcollection points back to it.
      match /chapters/{nodeId} {
        allow get, list: if true;
        allow create, update: if request.resource.data.title is string
                               && request.resource.data.title.size() < 300;
        allow delete: if request.auth != null
                       && get(/databases/$(database)/documents/shareLinks/$(token)).data.ownerId == request.auth.uid;
      }

      // Chapter-level discussion threads — anyone with the link can read
      // and post; only the manuscript's owner can delete (moderation).
      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if request.resource.data.authorName is string
                       && request.resource.data.authorName.size() > 0
                       && request.resource.data.authorName.size() < 80
                       && request.resource.data.text is string
                       && request.resource.data.text.size() > 0
                       && request.resource.data.text.size() < 4000;
        allow update: if false;
        allow delete: if request.auth != null
                       && get(/databases/$(database)/documents/shareLinks/$(token)).data.ownerId == request.auth.uid;
      }
    }
  }
}
